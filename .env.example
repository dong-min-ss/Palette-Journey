# Local sticker testing only; production must use 0.
PALETTE_DEV_UNLOCK_STICKERS=0

# Default: this PC only. For same-Wi-Fi phone testing, opt in to 0.0.0.0
# and replace the web origin with this PC's Wi-Fi IPv4 address.
PALETTE_LISTEN_HOST=127.0.0.1
PALETTE_WEB_ORIGIN=http://localhost:3000

# Mock coordinates only. Never enables real Pleos location verification.
PALETTE_MOCK_LOCATION=0
